backend/prisma/dev.db
backend/prisma/dev.db-journal
backend/prisma/migrations/

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Claude Code local session state
/.claude/

# IDE
/.vscode/
/.idea/
