# Per-app artifacts (also ignored by each app's own .gitignore)
**/node_modules/
**/.next/
**/dist/
**/*.tsbuildinfo
**/next-env.d.ts

# misc
.DS_Store
*.pem

# local env files
.env
.env.local
.env.development.local
.env.test.local
.env.production.local

