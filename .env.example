# Welona Admin Panel - Environment Variables
# Reference: Developer Reference Architecture v2.0, section 9.4.
#
# Copy to `.env` (used by Prisma CLI + Next.js server) and
# `.env.local` (browser-exposed NEXT_PUBLIC_* values).

# --- Database (section 5.1) ---
# Local dev uses SQLite. For production PostgreSQL use:
#   DATABASE_URL="postgresql://user:pass@localhost:5432/welona"
DATABASE_URL="file:./dev.db"

# --- Auth / JWT (section 7.1) ---
JWT_SECRET="generate-with: openssl rand -base64 64"
JWT_REFRESH_SECRET="generate-with: openssl rand -base64 64"
JWT_EXPIRY="1h"
REFRESH_TOKEN_EXPIRY="7d"

# --- Browser-exposed (.env.local) ---
# Base URL the Admin Panel calls. The app serves its own /api/v1 routes.
NEXT_PUBLIC_API_URL=/api/v1
NEXT_PUBLIC_WS_URL=http://localhost:3001
NEXT_PUBLIC_APP_NAME=Welona Admin
