{
  "name": "welona-admin-backend",
  "version": "0.1.0",
  "private": true,
  "description": "Welona Admin Panel — backend API (Next.js route handlers + Prisma/SQLite)",
  "scripts": {
    "dev": "next dev -p 3002",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "type-check": "tsc --noEmit",
    "db:push": "prisma db push",
    "db:seed": "prisma db seed",
      "db:seed-showcase": "tsx prisma/seed-admin-showcase.ts",
    "db:seed-system-users": "tsx prisma/seed-admin-system-users.ts",
    "db:seed-hr": "tsx prisma/seed-hr.ts",
    "db:seed-products": "tsx prisma/seed-products-inventory.ts",
    "db:seed-warehouse-stock": "tsx prisma/seed-warehouse-stock.ts",
    "db:seed-all": "prisma db seed && tsx prisma/seed-admin-showcase.ts && tsx prisma/seed-admin-system-users.ts && tsx prisma/seed-hr.ts && tsx prisma/seed-products-inventory.ts && tsx prisma/seed-warehouse-stock.ts",
    "db:studio": "prisma studio",
    "db:reset": "prisma db push --force-reset && prisma db seed",
    "db:reset-all": "prisma db push --force-reset && npm run db:seed-all",
    "postinstall": "prisma generate"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@prisma/client": "^5.22.0",
    "bcryptjs": "^2.4.3",
    "jsonwebtoken": "^9.0.2",
    "next": "14.2.15",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/jsonwebtoken": "^9.0.7",
    "@types/node": "20.16.11",
    "@types/react": "18.3.11",
    "@types/react-dom": "18.3.0",
    "eslint": "8.57.1",
    "eslint-config-next": "14.2.15",
    "prisma": "^5.22.0",
    "tsx": "^4.19.2",
    "typescript": "5.6.3"
  }
}
