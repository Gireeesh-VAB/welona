# Welona Admin Backend - Environment Variables
# Reference: Developer Reference Architecture v2.0, section 9.4.

# --- Database (section 5.1) ---
# Local dev uses SQLite. For production PostgreSQL:
#   DATABASE_URL="postgresql://user:pass@localhost:5432/welona"
DATABASE_URL="file:./dev.db"

# --- Auth / JWT (section 7.1) ---
JWT_SECRET="generate-with: openssl rand -base64 64"
JWT_REFRESH_SECRET="generate-with: openssl rand -base64 64"
JWT_EXPIRY="1h"
REFRESH_TOKEN_EXPIRY="7d"

# --- CORS ---
# Comma-separated list of allowed origins. Use `*` to reflect any origin
# (development only — do NOT use in production with credentials).
#   Local dev only:  CORS_ALLOWED_ORIGIN="http://localhost:3001"
#   Dev + prod:      CORS_ALLOWED_ORIGIN="http://localhost:3001,https://welona.vabinformatics.com"
CORS_ALLOWED_ORIGIN="http://localhost:3001,https://welona.vabinformatics.com"
