# Production build config — used by `next build` and `next start`.
# Local dev (`next dev`) keeps using `.env.local`, so localhost still works.
#
# In production the frontend and backend are served from the same subdomain
# (path-routed by nginx: /api/* → backend :3002, everything else → frontend
# :3001), so the API base URL is just /api/v1 on the same host.
NEXT_PUBLIC_API_URL=https://welona.vabinformatics.com/api/v1
NEXT_PUBLIC_WS_URL=https://welona.vabinformatics.com
NEXT_PUBLIC_APP_NAME=Welona Admin
