# Browser-exposed config for the Admin Panel.
# Point this at the backend service's /api/v1 base URL.
#
# Env-file precedence (Next.js):
#   .env.local       → loaded in both dev and prod (gitignored)
#   .env.development → loaded by `next dev`
#   .env.production  → loaded by `next build` / `next start`
#   .env             → fallback for both
#
# This repo keeps `.env.local` pointing at localhost (for `next dev`) and
# `.env.production` pointing at the deployed subdomain.
NEXT_PUBLIC_API_URL=http://localhost:3002/api/v1
NEXT_PUBLIC_WS_URL=http://localhost:3002
NEXT_PUBLIC_APP_NAME=Welona Admin
