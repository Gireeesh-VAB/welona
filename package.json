{
  "name": "welona-admin",
  "version": "0.1.0",
  "private": true,
  "description": "Welona Health & Wellness - Admin Panel (Web Application)",
  "scripts": {
    "dev": "next dev -p 3001",
    "build": "next build",
    "start": "next start -p 3001",
    "lint": "next lint",
    "type-check": "tsc --noEmit",
    "db:push": "prisma db push",
    "db:seed": "prisma db seed",
    "db:studio": "prisma studio",
    "db:reset": "prisma db push --force-reset && prisma db seed",
    "postinstall": "prisma generate"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@ant-design/icons": "5.5.1",
    "@ant-design/nextjs-registry": "1.0.2",
    "@prisma/client": "^5.22.0",
    "@tanstack/react-query": "5.59.0",
    "antd": "5.21.4",
    "bcryptjs": "^2.4.3",
    "dayjs": "1.11.13",
    "echarts": "5.5.1",
    "echarts-for-react": "3.0.2",
    "html2canvas": "^1.4.1",
    "jsonwebtoken": "^9.0.2",
    "jspdf": "^4.2.1",
    "next": "14.2.15",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "zod": "^3.23.8",
    "zustand": "4.5.5"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/jsonwebtoken": "^9.0.7",
    "@types/node": "20.16.11",
    "@types/react": "18.3.11",
    "@types/react-dom": "18.3.0",
    "autoprefixer": "10.4.20",
    "eslint": "8.57.1",
    "eslint-config-next": "14.2.15",
    "postcss": "8.4.47",
    "prisma": "^5.22.0",
    "tailwindcss": "3.4.13",
    "tsx": "^4.19.2",
    "typescript": "5.6.3"
  }
}
